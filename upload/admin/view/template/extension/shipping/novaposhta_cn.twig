{{ header }}{{ column_left }}
<div id="content" class="np-admin">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ refresh }}" class="btn btn-primary">{{ button_refresh }}</a>
        <a href="{{ settings }}" class="btn btn-default">{{ menu_settings }}</a>
      </div>
      <h1>{{ heading_cn }} <span class="np-ver">{{ np_version }}</span></h1>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <form method="get" action="index.php" class="np-filters">
      <input type="hidden" name="route" value="extension/shipping/novaposhta_cn" />
      <input type="hidden" name="user_token" value="{{ user_token }}" />
      <input type="text" name="filter_order_id" value="{{ filter_order_id }}" placeholder="{{ column_order }}" />
      <input type="text" name="filter_cn" value="{{ filter_cn }}" placeholder="{{ column_ttn }}" />
      <select name="filter_has_cn">
        <option value="">{{ text_all }}</option>
        <option value="1" {% if filter_has_cn == '1' %}selected{% endif %}>{{ text_with_cn }}</option>
        <option value="0" {% if filter_has_cn == '0' %}selected{% endif %}>{{ text_without_cn }}</option>
      </select>
      <button type="submit" class="btn btn-default">{{ button_filter }}</button>
    </form>
    <div class="np-tabs">
      <a href="index.php?route=extension/shipping/novaposhta_cn&user_token={{ user_token }}" {% if not filter_group %}class="is-on"{% endif %}>{{ text_all }}</a>
      <a href="index.php?route=extension/shipping/novaposhta_cn&user_token={{ user_token }}&filter_group=none" {% if filter_group == 'none' %}class="is-on"{% endif %}>{{ text_tab_none }}</a>
      <a href="index.php?route=extension/shipping/novaposhta_cn&user_token={{ user_token }}&filter_group=transit" {% if filter_group == 'transit' %}class="is-on"{% endif %}>{{ text_tab_transit }}</a>
      <a href="index.php?route=extension/shipping/novaposhta_cn&user_token={{ user_token }}&filter_group=arrived" {% if filter_group == 'arrived' %}class="is-on"{% endif %}>{{ text_tab_arrived }}</a>
      <a href="index.php?route=extension/shipping/novaposhta_cn&user_token={{ user_token }}&filter_group=refused" {% if filter_group == 'refused' %}class="is-on"{% endif %}>{{ text_tab_refused }}</a>
      <a href="index.php?route=extension/shipping/novaposhta_cn&user_token={{ user_token }}&filter_group=money" {% if filter_group == 'money' %}class="is-on"{% endif %}>{{ text_tab_money }}</a>
      {% if queue %}<a href="{{ retry }}">{{ text_queue }} ({{ queue }})</a>{% endif %}
    </div>
    <form method="post" id="np-batch">
    <div class="np-batch">
      <button type="submit" formaction="{{ create }}">{{ button_create_selected }}</button>
      <button type="submit" formaction="{{ prints }}" name="kind" value="document">{{ button_print_selected }}</button>
      <button type="submit" formaction="{{ prints }}" name="kind" value="marking">{{ button_marking_selected }}</button>
      <input type="date" name="date" />
      <button type="submit" formaction="{{ registry }}">{{ button_registry }}</button>
      <select name="sender_id">
        <option value="">{{ text_main_sender }}</option>
        {% for sender in senders %}
        <option value="{{ sender.id }}">{{ sender.name }}</option>
        {% endfor %}
      </select>
      <select name="interval">
        {% for interval in intervals %}
        <option value="{{ interval.id }}">{{ interval.name }}</option>
        {% endfor %}
      </select>
      <input type="text" name="weight" value="1" style="width:70px" />
      <button type="submit" formaction="{{ courier }}">{{ button_courier }}</button>
    </div>
      <table class="np-cn">
        <thead>
          <tr>
            <th></th>
            <th>{{ column_order }}</th>
            <th>{{ column_customer }}</th>
            <th>{{ column_city }}</th>
            <th>{{ column_ttn }}</th>
            <th>{{ column_status }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
          <tr>
            <td><input type="checkbox" name="selected[]" value="{{ row.order_id }}" /></td>
            <td><a href="{{ row.order }}">#{{ row.order_id }}</a><div class="np-muted">{{ row.date }}</div></td>
            <td>{{ row.customer }}<div class="np-muted">{{ row.phone }}</div></td>
            <td>{{ row.city }}<div class="np-muted">{{ row.division }}</div></td>
            <td>{% if row.cn %}{{ row.cn }}{% else %}<span class="np-muted">{{ text_no_cn }}</span>{% endif %}</td>
            <td>{% if row.status %}<span class="np-badge np-{{ row.code in [7, 8] ? 'arrived' : (row.code in [102, 103] ? 'refused' : (row.code in [10, 11] ? 'money' : 'transit')) }}">{{ row.status }}</span>{% endif %}</td>
            <td class="np-actions">
              {% if row.pdf %}<a href="{{ row.pdf }}" target="_blank">{{ button_pdf }}</a>{% endif %}
              {% if row.marking %}<a href="{{ row.marking }}" target="_blank">{{ button_marking }}</a>{% endif %}
              {% if row.cn %}
              <button type="button" class="np-del" data-id="{{ row.order_id }}">{{ button_delete }}</button>
              {% endif %}
            </td>
          </tr>
          {% else %}
          <tr><td colspan="7">{{ text_cn_empty }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </form>
    <form id="np-delete" method="post" action="{{ delete }}">
      <input type="hidden" name="order_id" id="np-delete-id" />
    </form>
    <script>
    document.querySelectorAll('.np-del').forEach(function (button) {
      button.addEventListener('click', function () {
        if (!window.confirm('{{ button_delete }}?')) return;
        document.getElementById('np-delete-id').value = button.getAttribute('data-id');
        document.getElementById('np-delete').submit();
      });
    });
    </script>
    <div class="np-pager">{{ pagination }} <span>{{ results }}</span></div>
    {% if sheets %}
    <div class="np-sheets">
      {% for sheet in sheets %}
      <a href="{{ sheet.pdf }}">{{ text_registry }} {{ sheet.number }} {{ sheet.date }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
<style>
.np-admin { color:#1c1917; }
.np-ver { display:inline-block; margin-left:8px; padding:2px 8px; border-radius:999px; background:#1c1917; color:#fff; font-size:12px; font-weight:700; vertical-align:middle; }
.np-filters { display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap; }
.np-tabs { display:flex; gap:8px; flex-wrap:wrap; margin:0 0 12px; }
.np-tabs a { padding:6px 10px; border-radius:999px; background:#f6f3ee; color:#1c1917; }
.np-tabs a.is-on { background:#1c1917; color:#fff; }
.np-badge { display:inline-block; padding:2px 8px; border-radius:999px; font-size:12px; }
.np-arrived { background:#e5f6e8; }
.np-refused { background:#fde8e8; }
.np-money { background:#fff4d6; }
.np-transit { background:#e8f1fb; }
.np-sheets { display:flex; gap:10px; flex-wrap:wrap; margin-top:10px; }
.np-batch button { border:0; background:#1c1917; color:#fff; border-radius:10px; height:34px; padding:0 10px; }
.np-filters input, .np-filters select { height:38px; border:1px solid #e6e0d6; border-radius:10px; padding:0 10px; }
.np-table-wrap { background:#fff; border:1px solid #e6e0d6; border-radius:16px; overflow:auto; }
.np-cn { width:100%; border-collapse:collapse; min-width:760px; }
.np-cn th { text-align:left; font-size:12px; color:#6f675e; padding:12px; background:#f6f3ee; }
.np-cn td { padding:12px; border-top:1px solid #eee7dc; vertical-align:top; }
.np-muted { color:#6f675e; font-size:12px; }
.np-actions { display:flex; gap:8px; align-items:center; white-space:nowrap; }
.np-actions a, .np-actions button { border:0; background:transparent; color:#1c1917; padding:0; font-weight:700; }
.np-actions form { margin:0; }
.np-pager { margin-top:12px; }
</style>
{{ footer }}
