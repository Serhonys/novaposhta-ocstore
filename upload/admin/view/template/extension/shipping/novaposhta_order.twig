<div class="panel panel-default" id="novaposhta-order">
  <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-truck"></i> {{ heading }} <span style="display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;background:#1c1917;color:#fff;font-size:11px;">{{ np_version }}</span></h3></div>
  <div class="panel-body">
    {% if row %}
    <p>
      <strong>{{ row.city_name }}</strong>
      {% if row.division_name %} — {{ row.division_name }}{% endif %}
      {% if row.street_name %} — {{ row.street_name }} {{ row.building }}{% endif %}
    </p>
    {% if not row.city_ref or (row.method != 'doors' and not row.division_ref) %}
    <div class="alert alert-warning">{{ text_missing_ref }}</div>
    {% endif %}
    {% else %}
    <div class="alert alert-warning">{{ text_missing_ref }}</div>
    {% endif %}
    <div class="row" style="margin-bottom:12px;">
      <div class="col-sm-4"><input class="form-control" id="np-city" placeholder="{{ column_city|default('Місто') }}" value="{{ row.city_name|default('') }}" autocomplete="off" /></div>
      <div class="col-sm-5"><input class="form-control" id="np-point" placeholder="{{ column_ttn|default('Відділення') }}" value="{{ row.division_name|default('') }}" autocomplete="off" /></div>
      <div class="col-sm-3"><button type="button" class="btn btn-default" id="np-save-point">{{ button_save }}</button> <span id="np-hours"></span></div>
    </div>

    {% if row.cn_number %}
    <p><strong>ТТН:</strong> {{ row.cn_number }}</p>
    {% if row.status_text %}<p>{{ row.status_text }}{% if row.status_code %} ({{ row.status_code }}){% endif %}</p>{% endif %}
    <p>
      {% if pdf %}<a class="btn btn-default" target="_blank" href="{{ pdf }}">{{ button_pdf }}</a>{% endif %}
      {% if marking %}<a class="btn btn-default" target="_blank" href="{{ marking }}">{{ button_marking }}</a>{% endif %}
      <button type="button" class="btn btn-danger" id="np-delete">{{ button_delete }}</button>
      <button type="button" class="btn btn-default" id="np-update">{{ button_update }}</button>
    </p>
    <div class="row">
      <div class="col-sm-3"><input class="form-control" id="np-e-weight" value="{{ weight }}" placeholder="{{ entry_weight }}" /></div>
      <div class="col-sm-3"><input class="form-control" id="np-e-phone" value="{{ telephone }}" placeholder="{{ entry_phone }}" /></div>
      <div class="col-sm-6"><input class="form-control" id="np-e-description" value="{{ description }}" placeholder="{{ entry_description }}" /></div>
    </div>
    {% else %}
    <div class="form-horizontal">
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_weight }}</label>
        <div class="col-sm-4"><input class="form-control" id="np-weight" value="{{ weight }}" /></div>
        <label class="col-sm-2 control-label">{{ entry_cost }}</label>
        <div class="col-sm-4"><input class="form-control" id="np-cost" value="{{ total }}" /></div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_seats }}</label>
        <div class="col-sm-4"><input class="form-control" id="np-seats" value="1" /></div>
        <label class="col-sm-2 control-label">{{ entry_phone }}</label>
        <div class="col-sm-4"><input class="form-control" id="np-phone" value="{{ telephone }}" /></div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_description }}</label>
        <div class="col-sm-10"><input class="form-control" id="np-description" value="{{ description }}" /></div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_payer }}</label>
        <div class="col-sm-4">
          <select class="form-control" id="np-payer">
            <option value="Recipient" {% if payer == 'Recipient' %}selected{% endif %}>{{ text_recipient }}</option>
            <option value="Sender" {% if payer == 'Sender' %}selected{% endif %}>{{ text_sender }}</option>
          </select>
        </div>
        <label class="col-sm-2 control-label">{{ entry_payment }}</label>
        <div class="col-sm-4">
          <select class="form-control" id="np-payment">
            <option value="Cash" {% if payment == 'Cash' %}selected{% endif %}>{{ text_pay_cash }}</option>
            <option value="NonCash" {% if payment == 'NonCash' %}selected{% endif %}>{{ text_pay_noncash }}</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_places }}</label>
        <div class="col-sm-10" id="np-places">
          {% if places %}
          {% for place in places %}
          <div class="np-place" style="display:flex;gap:6px;margin-bottom:6px;">
            <input class="form-control np-p-weight" placeholder="кг" value="{{ place.weight }}" />
            <input class="form-control np-p-l" placeholder="см д" value="{{ place.length }}" />
            <input class="form-control np-p-w" placeholder="см ш" value="{{ place.width }}" />
            <input class="form-control np-p-h" placeholder="см в" value="{{ place.height }}" />
          </div>
          {% endfor %}
          {% else %}
          <div class="np-place" style="display:flex;gap:6px;margin-bottom:6px;">
            <input class="form-control np-p-weight" placeholder="кг" />
            <input class="form-control np-p-l" placeholder="см д" />
            <input class="form-control np-p-w" placeholder="см ш" />
            <input class="form-control np-p-h" placeholder="см в" />
          </div>
          {% endif %}
          <button type="button" class="btn btn-default btn-xs" id="np-place-add">+</button>
        </div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_cargo }}</label>
        <div class="col-sm-4">
          <select class="form-control" id="np-cargo">
            <option value="Parcel">{{ text_cargo_parcel }}</option>
            <option value="Cargo">{{ text_cargo_cargo }}</option>
            <option value="Pallet">{{ text_cargo_pallet }}</option>
            <option value="TiresWheels">{{ text_cargo_tires }}</option>
          </select>
        </div>
        <label class="col-sm-2 control-label">{{ entry_edrpou }}</label>
        <div class="col-sm-2"><input class="form-control" id="np-edrpou" placeholder="ЄДРПОУ" /></div>
        <div class="col-sm-2"><input class="form-control" id="np-company" placeholder="{{ entry_company }}" /></div>
      </div>
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_backward }}</label>
        <div class="col-sm-4">
          <select class="form-control" id="np-backward">
            <option value="">—</option>
            <option value="Money">{{ text_back_money }}</option>
            <option value="Documents">{{ text_back_docs }}</option>
            <option value="Trays">{{ text_back_trays }}</option>
          </select>
        </div>
        <div class="col-sm-6"><input class="form-control" id="np-backward-info" placeholder="1" /></div>
      </div>
      {% if senders %}
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ entry_sender }}</label>
        <div class="col-sm-10">
          <select class="form-control" id="np-sender">
            <option value="">Основний</option>
            {% for sender in senders %}
            <option value="{{ sender.id }}">{{ sender.name }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      {% endif %}
      <div class="form-group">
        <label class="col-sm-2 control-label">{{ text_cod }}</label>
        <div class="col-sm-4"><input class="form-control" id="np-cod" value="{{ cod }}" /></div>
        <div class="col-sm-6"><button type="button" class="btn btn-primary" id="np-create">{{ button_create }}</button></div>
      </div>
    </div>
    {% endif %}
    <div id="np-result" class="help-block"></div>
  </div>
</div>
<script>
(function () {
  var token = '{{ user_token }}';
  var orderId = '{{ order_id }}';
  $('#np-create').on('click', function () {
    var cod = parseFloat($('#np-cod').val() || '0');
    var places = [];
    $('#np-places .np-place').each(function () {
      places.push({
        weight: $(this).find('.np-p-weight').val(),
        length: $(this).find('.np-p-l').val(),
        width: $(this).find('.np-p-w').val(),
        height: $(this).find('.np-p-h').val()
      });
    });
    $('#np-result').text('...');
    $.post('index.php?route=extension/shipping/novaposhta/createCn&user_token=' + token, {
      order_id: orderId,
      weight: $('#np-weight').val(),
      cost: $('#np-cost').val(),
      seats: $('#np-seats').val(),
      description: $('#np-description').val(),
      payer: $('#np-payer').val(),
      payment: $('#np-payment').val(),
      phone: $('#np-phone').val(),
      cod: cod > 0 ? 1 : 0,
      cod_sum: cod,
      places: places,
      backward: $('#np-backward').val(),
      backward_info: $('#np-backward-info').val(),
      sender_id: $('#np-sender').val() || '',
      cargo: $('#np-cargo').val(),
      edrpou: $('#np-edrpou').val(),
      company: $('#np-company').val()
    }, function (json) {
      if (json.error) {
        $('#np-result').text(json.error);
        return;
      }
      location.reload();
    }, 'json');
  });
  $('#np-place-add').on('click', function () {
    var $row = $('#np-places .np-place').first().clone();
    $row.find('input').val('');
    $row.insertBefore('#np-place-add');
  });
  var cityRef = '{{ row.city_ref|default('') }}';
  var pointRef = '{{ row.division_ref|default('') }}';
  function remember(input, rows, onPick) {
    var $list = $('<div class="list-group" style="position:absolute;z-index:5;max-height:220px;overflow:auto;"></div>');
    $.each(rows || [], function (_, row) {
      var $item = $('<a href="#" class="list-group-item"></a>').text(row.area ? row.name + ', ' + row.area : row.name);
      $item.on('click', function (e) {
        e.preventDefault();
        onPick(row);
        $list.remove();
      });
      $list.append($item);
    });
    $(input).after($list);
  }
  $('#np-city').on('input', function () {
    var q = $.trim(this.value);
    cityRef = '';
    if (q.length < 2) return;
    $.getJSON('index.php?route=extension/shipping/novaposhta/cities&user_token=' + token, { q: q }, function (rows) {
      remember('#np-city', rows, function (row) {
        $('#np-city').val(row.name);
        cityRef = row.ref;
      });
    });
  });
  $('#np-point').on('input', function () {
    if (!cityRef) return;
    $.getJSON('index.php?route=extension/shipping/novaposhta/warehouses&user_token=' + token, { city_ref: cityRef, q: this.value }, function (rows) {
      remember('#np-point', rows, function (row) {
        $('#np-point').val(row.name);
        pointRef = row.ref;
        $.getJSON('index.php?route=extension/shipping/novaposhta/hours&user_token=' + token, { ref: row.ref }, function (json) {
          $('#np-hours').text(json.hours || '');
        });
      });
    });
  });
  $('#np-save-point').on('click', function () {
    $.post('index.php?route=extension/shipping/novaposhta/savePoint&user_token=' + token, {
      order_id: orderId,
      city_ref: cityRef,
      city_name: $('#np-city').val(),
      division_ref: pointRef,
      division_name: $('#np-point').val(),
      method: 'department'
    }, function () {
      $('#np-result').text('OK');
    }, 'json');
  });
  $('#np-update').on('click', function () {
    $.post('index.php?route=extension/shipping/novaposhta/updateCn&user_token=' + token, {
      order_id: orderId,
      weight: $('#np-e-weight').val(),
      phone: $('#np-e-phone').val(),
      description: $('#np-e-description').val(),
      cost: '{{ total }}',
      seats: 1,
      city_ref: cityRef,
      city_name: $('#np-city').val(),
      division_ref: pointRef,
      division_name: $('#np-point').val()
    }, function (json) {
      $('#np-result').text(json.error || 'OK');
      if (!json.error) location.reload();
    }, 'json');
  });
  $('#np-delete').on('click', function () {
    $.post('index.php?route=extension/shipping/novaposhta/deleteCn&user_token=' + token, { order_id: orderId }, function (json) {
      if (json.error) {
        $('#np-result').text(json.error);
        return;
      }
      location.reload();
    }, 'json');
  });
})();
</script>
