{{ header }}{{ column_left }}
<div id="content" class="np-admin">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right np-actions">
        <button type="submit" form="form-shipping" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button>
        <a href="{{ cn_link }}" class="btn btn-default"><i class="fa fa-file-text-o"></i> {{ menu_cn }}</a>
        <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
    {% endif %}
    {% if counts.warehouses == 0 and counts.lockers == 0 %}
    <div class="alert alert-warning"><i class="fa fa-database"></i> {{ text_sync_needed }}</div>
    {% endif %}

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping">
      <div class="np-shell">
        <nav class="np-nav">
          <button type="button" class="is-on" data-pane="general">{{ tab_general }}</button>
          <button type="button" data-pane="methods">{{ tab_methods }}</button>
          <button type="button" data-pane="tariff">{{ tab_tariff }}</button>
          <button type="button" data-pane="sender">{{ tab_sender }}</button>
          <button type="button" data-pane="sync">{{ tab_sync }}</button>
          <button type="button" data-pane="track">{{ tab_track }}</button>
          <button type="button" data-pane="log">{{ tab_log }}</button>
          <button type="button" data-pane="versions">{{ tab_versions }}</button>
        </nav>
        <div class="np-main">
          <section class="np-pane is-on" id="np-general">
            <button type="button" class="np-help" data-help="general" title="{{ button_help }}">?</button>
            <div class="np-grid">
              <label>{{ entry_status }}
                <select name="shipping_novaposhta_status">
                  <option value="1" {% if shipping_novaposhta_status %}selected{% endif %}>{{ text_enabled }}</option>
                  <option value="0" {% if not shipping_novaposhta_status %}selected{% endif %}>{{ text_disabled }}</option>
                </select>
              </label>
              <label>{{ entry_sort_order }}
                <input type="text" name="shipping_novaposhta_sort_order" value="{{ shipping_novaposhta_sort_order }}" />
              </label>
            </div>
            <label>{{ entry_api_key }}
              <span class="np-inline">
                <input type="text" name="shipping_novaposhta_api_key" value="{{ shipping_novaposhta_api_key }}" id="input-api-key" autocomplete="off" />
                <button type="button" id="button-save-key">{{ button_save_key }}</button>
                <button type="button" id="button-api-check">{{ button_check }}</button>
              </span>
              <small id="api-check-result"></small>
            </label>
            <div class="np-grid">
              <label>{{ entry_country }}
                <select name="shipping_novaposhta_country_id">
                  <option value="0">{{ text_all_countries }}</option>
                  {% for country in countries %}
                  <option value="{{ country.country_id }}" {% if country.country_id == shipping_novaposhta_country_id %}selected{% endif %}>{{ country.name }}</option>
                  {% endfor %}
                </select>
                <small>{{ help_country }}</small>
              </label>
              <label>{{ entry_weight }}
                <input type="text" name="shipping_novaposhta_default_weight" value="{{ shipping_novaposhta_default_weight }}" />
                <small>{{ help_weight }}</small>
              </label>
            </div>
            <label>{{ entry_description }}
              <textarea class="np-grow" name="shipping_novaposhta_cargo_description" rows="3">{{ shipping_novaposhta_cargo_description }}</textarea>
              <small class="np-tokens">{{ help_description }}</small>
            </label>
            <div class="np-grid">
              <label>{{ entry_payer }}
                <select name="shipping_novaposhta_payer">
                  <option value="Recipient" {% if shipping_novaposhta_payer == 'Recipient' %}selected{% endif %}>{{ text_recipient }}</option>
                  <option value="Sender" {% if shipping_novaposhta_payer == 'Sender' %}selected{% endif %}>{{ text_sender }}</option>
                </select>
              </label>
              <label>{{ entry_payment }}
                <select name="shipping_novaposhta_payment">
                  <option value="Cash" {% if shipping_novaposhta_payment == 'Cash' %}selected{% endif %}>Cash</option>
                  <option value="NonCash" {% if shipping_novaposhta_payment == 'NonCash' %}selected{% endif %}>NonCash</option>
                </select>
              </label>
            </div>
            <label>{{ entry_cod }}
              <select name="shipping_novaposhta_cod[]" multiple size="6">
                {% for payment in payments %}
                <option value="{{ payment.code }}" {% if payment.code in shipping_novaposhta_cod %}selected{% endif %}>{{ payment.name }}</option>
                {% endfor %}
              </select>
              <small>{{ help_cod }}</small>
            </label>
            <label>{{ entry_cod_status }}
              <select name="shipping_novaposhta_cod_status">
                <option value="0">{{ text_skip }}</option>
                {% for status in order_statuses %}
                <option value="{{ status.order_status_id }}" {% if shipping_novaposhta_cod_status == status.order_status_id %}selected{% endif %}>{{ status.name }}</option>
                {% endfor %}
              </select>
              <small>{{ help_cod_status }}</small>
            </label>
            <label>{{ entry_sms }}
              <input type="text" name="shipping_novaposhta_sms_url" value="{{ shipping_novaposhta_sms_url }}" />
              <small>{{ help_sms }}</small>
            </label>
            <h3>{{ entry_checkout }}</h3>
            <p class="np-note">{{ help_checkout }}</p>
            <div class="np-grid">
              <label>{{ entry_checkout_city }}
                <input type="text" name="shipping_novaposhta_checkout_city" value="{{ shipping_novaposhta_checkout_city }}" placeholder="shipping_address[city]" />
              </label>
              <label>{{ entry_checkout_point }}
                <input type="text" name="shipping_novaposhta_checkout_point" value="{{ shipping_novaposhta_checkout_point }}" placeholder="shipping_address[address_1]" />
              </label>
              <label>{{ entry_checkout_street }}
                <input type="text" name="shipping_novaposhta_checkout_street" value="{{ shipping_novaposhta_checkout_street }}" />
              </label>
              <label>{{ entry_checkout_building }}
                <input type="text" name="shipping_novaposhta_checkout_building" value="{{ shipping_novaposhta_checkout_building }}" />
              </label>
              <label>{{ entry_checkout_flat }}
                <input type="text" name="shipping_novaposhta_checkout_flat" value="{{ shipping_novaposhta_checkout_flat }}" />
              </label>
              <label>{{ entry_lang }}
                <select name="shipping_novaposhta_lang">
                  <option value="auto" {% if shipping_novaposhta_lang != 'uk' and shipping_novaposhta_lang != 'ru' %}selected{% endif %}>{{ text_lang_auto }}</option>
                  <option value="uk" {% if shipping_novaposhta_lang == 'uk' %}selected{% endif %}>{{ text_lang_uk }}</option>
                  <option value="ru" {% if shipping_novaposhta_lang == 'ru' %}selected{% endif %}>{{ text_lang_ru }}</option>
                </select>
              </label>
            </div>
          </section>

          <section class="np-pane" id="np-methods">
            <button type="button" class="np-help" data-help="methods" title="{{ button_help }}">?</button>
            {% for code in ['department', 'poshtomat', 'doors'] %}
            {% set method = shipping_novaposhta_method[code]|default({}) %}
            <article class="np-card">
              <h3>{{ attribute(_context, 'text_method_' ~ code) }}</h3>
              <div class="np-grid">
                <label>{{ entry_status }}
                  <select name="shipping_novaposhta_method[{{ code }}][status]">
                    <option value="1" {% if method.status %}selected{% endif %}>{{ text_enabled }}</option>
                    <option value="0" {% if not method.status %}selected{% endif %}>{{ text_disabled }}</option>
                  </select>
                </label>
                <label>{{ entry_api_calc }}
                  <select name="shipping_novaposhta_method[{{ code }}][api]">
                    <option value="1" {% if method.api is not defined or method.api %}selected{% endif %}>{{ text_yes }}</option>
                    <option value="0" {% if method.api is defined and not method.api %}selected{% endif %}>{{ text_no }}</option>
                  </select>
                </label>
                <label>{{ entry_free_from }}
                  <input type="text" name="shipping_novaposhta_method[{{ code }}][free_from]" value="{{ method.free_from|default('') }}" />
                </label>
                <label>{{ entry_geo_zone }}
                  <select name="shipping_novaposhta_method[{{ code }}][geo_zone_id]">
                    <option value="0">{{ text_all_zones }}</option>
                    {% for geo_zone in geo_zones %}
                    <option value="{{ geo_zone.geo_zone_id }}" {% if method.geo_zone_id|default(0) == geo_zone.geo_zone_id %}selected{% endif %}>{{ geo_zone.name }}</option>
                    {% endfor %}
                  </select>
                </label>
                <label>{{ entry_tax }}
                  <select name="shipping_novaposhta_method[{{ code }}][tax_class_id]">
                    <option value="0">{{ text_none }}</option>
                    {% for tax_class in tax_classes %}
                    <option value="{{ tax_class.tax_class_id }}" {% if method.tax_class_id|default(0) == tax_class.tax_class_id %}selected{% endif %}>{{ tax_class.title }}</option>
                    {% endfor %}
                  </select>
                </label>
                {% if code != 'doors' %}
                <label>{{ entry_filter_weight }}
                  <select name="shipping_novaposhta_method[{{ code }}][filter_weight]">
                    <option value="1" {% if method.filter_weight is not defined or method.filter_weight %}selected{% endif %}>{{ text_yes }}</option>
                    <option value="0" {% if method.filter_weight is defined and not method.filter_weight %}selected{% endif %}>{{ text_no }}</option>
                  </select>
                </label>
                <label>{{ entry_filter_size }}
                  <select name="shipping_novaposhta_method[{{ code }}][filter_size]">
                    <option value="1" {% if method.filter_size is not defined or method.filter_size %}selected{% endif %}>{{ text_yes }}</option>
                    <option value="0" {% if method.filter_size is defined and not method.filter_size %}selected{% endif %}>{{ text_no }}</option>
                  </select>
                </label>
                {% endif %}
              </div>
              <small>{{ help_api_calc }}</small>
            </article>
            {% endfor %}
          </section>

          <section class="np-pane" id="np-tariff">
            <button type="button" class="np-help" data-help="tariff" title="{{ button_help }}">?</button>
            <p class="np-note">{{ help_tariff }}</p>
            <div class="np-table-wrap">
              <table id="tariff-table">
                <thead>
                  <tr>
                    <th>{{ column_weight }}</th>
                    <th>{{ column_warehouse }}</th>
                    <th>{{ column_city }}</th>
                    <th>{{ column_region }}</th>
                    <th>{{ column_ukraine }}</th>
                    <th>{{ column_doors }}</th>
                    <th>{{ column_doors_pickup }}</th>
                    <th>{{ column_locker }}</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in shipping_novaposhta_tariff %}
                  <tr>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][weight]" value="{{ row.weight }}" /></td>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][warehouse]" value="{{ row.warehouse|default(row.city|default('')) }}" /></td>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][city]" value="{{ row.city }}" /></td>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][region]" value="{{ row.region }}" /></td>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][ukraine]" value="{{ row.ukraine }}" /></td>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][doors]" value="{{ row.doors }}" /></td>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][doors_pickup]" value="{{ row.doors_pickup|default(0) }}" /></td>
                    <td><input name="shipping_novaposhta_tariff[{{ loop.index0 }}][locker]" value="{{ row.locker }}" /></td>
                    <td><button type="button" class="np-icon" onclick="$(this).closest('tr').remove();"><i class="fa fa-times"></i></button></td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <button type="button" id="button-tariff-add" class="np-ghost"><i class="fa fa-plus"></i> {{ button_add }}</button>
          </section>

          <section class="np-pane" id="np-sender">
            <button type="button" class="np-help" data-help="sender" title="{{ button_help }}">?</button>
            <label>{{ entry_sender }}
              <select name="shipping_novaposhta_sender_ref" id="input-sender">
                <option value="{{ shipping_novaposhta_sender_ref }}">{% if shipping_novaposhta_sender_name %}{{ shipping_novaposhta_sender_name }}{% else %}{{ text_name_after_check }}{% endif %}</option>
              </select>
              <input type="hidden" name="shipping_novaposhta_sender_name" id="input-sender-name" value="{{ shipping_novaposhta_sender_name }}" />
              <small>{{ help_sender }}</small>
            </label>
            <div class="np-grid">
              <label>{{ entry_contact }}
                <select name="shipping_novaposhta_sender_contact" id="input-contact">
                  <option value="{{ shipping_novaposhta_sender_contact }}">{% if shipping_novaposhta_sender_contact_name %}{{ shipping_novaposhta_sender_contact_name }}{% else %}{{ text_name_after_check }}{% endif %}</option>
                </select>
                <input type="hidden" name="shipping_novaposhta_sender_contact_name" id="input-contact-name" value="{{ shipping_novaposhta_sender_contact_name }}" />
              </label>
              <label>{{ entry_phone }}
                <input type="text" name="shipping_novaposhta_sender_phone" id="input-phone" value="{{ shipping_novaposhta_sender_phone }}" />
              </label>
            </div>
            <label>{{ entry_sender_type }}
              <select name="shipping_novaposhta_sender_type">
                <option value="Warehouse" {% if shipping_novaposhta_sender_type != 'Doors' %}selected{% endif %}>{{ text_from_warehouse }}</option>
                <option value="Doors" {% if shipping_novaposhta_sender_type == 'Doors' %}selected{% endif %}>{{ text_from_doors }}</option>
              </select>
            </label>
            <label>{{ entry_sender_address }}
              <select name="shipping_novaposhta_sender_address" id="input-address">
                <option value="{{ shipping_novaposhta_sender_address }}">{% if shipping_novaposhta_sender_address_name %}{{ shipping_novaposhta_sender_address_name }}{% else %}{{ text_name_after_check }}{% endif %}</option>
              </select>
              <input type="hidden" name="shipping_novaposhta_sender_address_name" id="input-address-name" value="{{ shipping_novaposhta_sender_address_name }}" />
              <input type="hidden" name="shipping_novaposhta_sender_city" id="input-sender-city" value="{{ shipping_novaposhta_sender_city }}" />
            </label>
            <h3>{{ text_more_senders }}</h3>
            <p class="np-note">{{ help_senders }}</p>
            {% for i in 0..2 %}
            {% set sender = shipping_novaposhta_senders[i]|default({}) %}
            <div class="np-card">
              <input type="hidden" name="shipping_novaposhta_senders[{{ i }}][id]" value="{{ i }}" />
              <div class="np-grid">
                <label>{{ entry_name }}<input type="text" name="shipping_novaposhta_senders[{{ i }}][name]" value="{{ sender.name|default('') }}" /></label>
                <label>API<input type="text" name="shipping_novaposhta_senders[{{ i }}][api_key]" value="{{ sender.api_key|default('') }}" autocomplete="off" /></label>
              </div>
              <div class="np-grid">
                <label>Ref<input type="text" name="shipping_novaposhta_senders[{{ i }}][ref]" value="{{ sender.ref|default('') }}" /></label>
                <label>{{ entry_contact }}
                  <input type="hidden" name="shipping_novaposhta_senders[{{ i }}][contact]" value="{{ sender.contact|default('') }}" />
                  <input type="text" name="shipping_novaposhta_senders[{{ i }}][contact_name]" value="{{ sender.contact_name|default('') }}" placeholder="{{ text_name_after_check }}" readonly />
                </label>
              </div>
              <div class="np-grid">
                <label>{{ entry_phone }}<input type="text" name="shipping_novaposhta_senders[{{ i }}][phone]" value="{{ sender.phone|default('') }}" /></label>
                <label>City ref<input type="text" name="shipping_novaposhta_senders[{{ i }}][city]" value="{{ sender.city|default('') }}" /></label>
              </div>
              <label>{{ entry_sender_address }}<input type="text" name="shipping_novaposhta_senders[{{ i }}][address]" value="{{ sender.address|default('') }}" /></label>
              <button type="button" class="np-probe" data-index="{{ i }}">{{ button_check }}</button>
              <label>{{ entry_sender_type }}
                <select name="shipping_novaposhta_senders[{{ i }}][type]">
                  <option value="Warehouse" {% if sender.type|default('Warehouse') != 'Doors' %}selected{% endif %}>{{ text_from_warehouse }}</option>
                  <option value="Doors" {% if sender.type|default('') == 'Doors' %}selected{% endif %}>{{ text_from_doors }}</option>
                </select>
              </label>
            </div>
            {% endfor %}
          </section>

          <section class="np-pane" id="np-sync">
            <button type="button" class="np-help" data-help="sync" title="{{ button_help }}">?</button>
            <div class="np-stats">
              <div><b id="np-stat-regions">{{ counts.regions }}</b><span>{{ text_regions }}</span></div>
              <div><b id="np-stat-cities">{{ counts.cities }}</b><span>{{ text_cities }}</span></div>
              <div><b id="np-stat-branches">{{ counts.warehouses }}</b><span>{{ text_branches }}</span></div>
              <div><b id="np-stat-lockers">{{ counts.lockers }}</b><span>{{ text_lockers }}</span></div>
            </div>
            <button type="button" id="button-sync" data-label-update="{{ button_sync_update }}">{% if directory_ready %}{{ button_sync_update }}{% else %}{{ button_sync }}{% endif %}</button>
            <p class="np-note">{{ help_sync }}</p>
            <pre id="sync-log"></pre>
          </section>

          <section class="np-pane" id="np-track">
            <button type="button" class="np-help" data-help="track" title="{{ button_help }}">?</button>
            <div class="np-grid">
              <label>{{ entry_cron_key }}
                <input type="text" name="shipping_novaposhta_cron_key" value="{{ shipping_novaposhta_cron_key }}" />
                <small>{{ help_cron }}</small>
              </label>
              <label>{{ entry_notify }}
                <select name="shipping_novaposhta_notify">
                  <option value="1" {% if shipping_novaposhta_notify %}selected{% endif %}>{{ text_yes }}</option>
                  <option value="0" {% if not shipping_novaposhta_notify %}selected{% endif %}>{{ text_no }}</option>
                </select>
              </label>
            </div>
            <label>{{ entry_alert }}
              <input type="text" name="shipping_novaposhta_alert_email" value="{{ shipping_novaposhta_alert_email }}" />
              <small>{{ help_alert }}</small>
            </label>
            <h3>{{ entry_status_map }}</h3>
            {% for code, label in {'7': text_status_7, '8': text_status_8, '9': text_status_9, '10': text_status_10, '102': text_status_102, '103': text_status_103} %}
            <div class="np-map">
              <span>{{ label }} <em>{{ code }}</em></span>
              <select name="shipping_novaposhta_status_map[{{ code }}]">
                <option value="0">{{ text_skip }}</option>
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id }}" {% if shipping_novaposhta_status_map[code]|default(0) == order_status.order_status_id %}selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
            {% endfor %}
            <div class="np-code">
              <code>{{ cron_track }}</code>
              <code>{{ cron_queue }}</code>
              <code>{{ cron_sync }}</code>
              <small>{{ help_cron_url }}</small>
            </div>
          </section>

          <section class="np-pane" id="np-log">
            <button type="button" class="np-help" data-help="log" title="{{ button_help }}">?</button>
            <table class="np-cn">
              <thead><tr><th></th><th>Method</th><th></th></tr></thead>
              <tbody>
                {% for log in logs %}
                <tr>
                  <td>{{ log.created_at }}</td>
                  <td>{{ log.model }}.{{ log.method }}</td>
                  <td>{{ log.success ? 'ok' : log.message }}</td>
                </tr>
                {% else %}
                <tr><td colspan="3">{{ text_log_empty }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </section>

          <section class="np-pane" id="np-versions">
            <button type="button" class="np-help" data-help="versions" title="{{ button_help }}">?</button>
            <ul class="np-versions">
              {% for row in changelog %}
              <li class="{% if row.current %}is-current{% endif %}">
                <b>{{ row.version }}</b>
                <span>{{ row.text }}</span>
              </li>
              {% endfor %}
            </ul>
          </section>
        </div>
      </div>
    </form>
  </div>
</div>
<div id="np-help" class="np-help-modal" hidden>
  <div class="np-help-card">
    <button type="button" class="np-help-x" aria-label="{{ button_help }}">×</button>
    <h3 id="np-help-title"></h3>
    <div id="np-help-text"></div>
  </div>
</div>
<script type="application/json" id="np-help-data">{{ help_panes_json|raw }}</script>
<style>
.np-admin { --ink:#1c1917; --muted:#6f675e; --line:#e6e0d6; --paper:#f6f3ee; --red:#c81e1e; }
.np-admin .np-shell { display:flex; gap:18px; align-items:flex-start; }
.np-admin .np-nav { width:210px; flex:0 0 210px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:8px; position:sticky; top:12px; }
.np-admin .np-nav button { display:block; width:100%; text-align:left; border:0; background:transparent; border-radius:10px; padding:10px 12px; color:var(--ink); font-weight:600; }
.np-admin .np-nav button.is-on { background:#1c1917; color:#fff; }
.np-admin .np-main { flex:1; min-width:0; background:#fff; border:1px solid var(--line); border-radius:16px; padding:22px; }
.np-admin .np-pane { display:none; position:relative; padding:8px 44px 0 0; }
.np-admin .np-pane.is-on { display:block; }
.np-admin .np-help { position:absolute; top:0; right:0; width:32px; height:32px; border-radius:999px; border:1px solid var(--line); background:#fff; color:var(--ink); font-weight:700; }
.np-help-modal { position:fixed; inset:0; background:rgba(28,25,23,.45); z-index:10000; display:flex; align-items:center; justify-content:center; padding:24px; }
.np-help-modal[hidden] { display:none; }
.np-help-card { position:relative; background:#fff; color:var(--ink); width:100%; max-width:640px; max-height:80vh; overflow:auto; border-radius:16px; padding:22px 22px 18px; }
.np-help-card h3 { margin:0 36px 12px 0; }
.np-help-card #np-help-text { white-space:pre-line; line-height:1.5; }
.np-help-x { position:absolute; top:12px; right:12px; width:32px; height:32px; border:0; border-radius:999px; background:#f6f3ee; font-size:20px; }
.np-admin label { display:block; margin:0 0 14px; color:var(--muted); font-size:13px; font-weight:600; }
.np-admin input, .np-admin select { display:block; width:100%; margin-top:6px; height:40px; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--ink); padding:0 12px; box-shadow:none; }
.np-admin textarea.np-grow { display:block; width:100%; min-height:88px; margin-top:6px; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--ink); padding:10px 12px; resize:vertical; line-height:1.45; field-sizing:content; }
.np-admin small.np-tokens { white-space:pre-line; line-height:1.55; }
.np-admin select[multiple] { height:auto; padding:8px; }
.np-admin small, .np-admin .np-note { display:block; color:var(--muted); font-weight:400; margin-top:6px; }
.np-admin .np-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px 16px; }
.np-admin .np-inline { display:flex; gap:8px; flex-wrap:wrap; }
.np-admin .np-inline input { flex:1; }
.np-admin .np-inline button, .np-admin .np-ghost, .np-admin #button-sync { border:0; border-radius:10px; background:#1c1917; color:#fff; height:40px; padding:0 14px; font-weight:700; }
.np-admin .np-ghost { background:#fff; color:var(--ink); border:1px solid var(--line); margin-top:12px; }
.np-admin #button-sync { width:100%; margin:8px 0 4px; }
.np-admin .np-card { border:1px solid var(--line); border-radius:14px; padding:16px 16px 6px; margin-bottom:14px; background:var(--paper); }
.np-admin .np-card h3, .np-admin h3 { margin:0 0 12px; font-size:16px; color:var(--ink); }
.np-admin .np-cn { width:100%; border-collapse:collapse; }
.np-admin .np-cn td { padding:8px 0; border-top:1px solid var(--line); font-size:13px; color:var(--ink); }
.np-admin .np-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
.np-admin .np-stats div { background:var(--paper); border-radius:14px; padding:14px; }
.np-admin .np-stats b { display:block; font-size:26px; color:var(--ink); line-height:1; }
.np-admin .np-stats span { color:var(--muted); font-size:12px; }
.np-admin .np-table-wrap { overflow:auto; border:1px solid var(--line); border-radius:12px; }
.np-admin #tariff-table { width:100%; border-collapse:collapse; min-width:860px; }
.np-admin #tariff-table th { font-size:12px; color:var(--muted); font-weight:600; padding:8px; background:var(--paper); }
.np-admin #tariff-table td { padding:6px; }
.np-admin #tariff-table input { height:34px; }
.np-admin .np-icon { border:0; background:transparent; color:var(--red); height:34px; }
.np-admin .np-map { display:grid; grid-template-columns:1fr 1fr; gap:12px; align-items:center; margin-bottom:8px; }
.np-admin .np-map em { color:var(--muted); font-style:normal; }
.np-admin .np-code code { display:block; background:var(--paper); border-radius:10px; padding:8px 10px; margin-top:8px; word-break:break-all; }
.np-admin .np-look { display:grid; grid-template-columns:1.2fr .8fr; gap:18px; align-items:start; }
.np-admin .np-presets { display:flex; gap:8px; margin:-6px 0 14px; }
.np-admin .np-presets button { border:1px solid var(--line); background:#fff; border-radius:999px; padding:6px 10px; font-weight:600; }
.np-admin input[type="range"] { padding:0; height:28px; }
.np-admin .np-check { display:flex; align-items:center; gap:8px; }
.np-admin .np-check input { width:auto; height:auto; margin:0; }
.np-admin .np-preview { background:var(--paper); border-radius:16px; padding:16px; }
.np-admin .np-preview.is-compact button { padding:4px 8px; font-size:12px; }
.np-admin .np-preview-types { display:flex; gap:6px; flex-wrap:wrap; }
.np-admin .np-preview-types button { border:1px solid #e4e0d8; background:#fff; padding:8px 12px; font-weight:700; }
.np-admin .np-preview-types button.is-on { color:#fff; }
.np-admin .np-preview-input { margin-top:8px; background:#fff; border:1px solid #e4e0d8; padding:10px 12px; color:#6f675e; }
.np-admin #sync-log { max-height:240px; overflow:auto; background:#1c1917; color:#f6f3ee; border-radius:12px; padding:12px; margin-top:12px; white-space:pre-wrap; }
.np-admin .np-actions .btn-primary { background:#1c1917; border-color:#1c1917; }
.np-ver { display:inline-block; margin-left:8px; padding:2px 8px; border-radius:999px; background:#1c1917; color:#fff; font-size:12px; font-weight:700; vertical-align:middle; }
.np-admin .np-versions { list-style:none; margin:0; padding:0; }
.np-admin .np-versions li { display:flex; gap:14px; align-items:flex-start; padding:12px 0; border-top:1px solid var(--line); color:var(--ink); }
.np-admin .np-versions b { flex:0 0 64px; color:var(--muted); }
.np-admin .np-versions .is-current b { color:#fff; background:#1c1917; border-radius:999px; text-align:center; line-height:22px; }
@media (max-width: 900px) {
  .np-admin .np-shell, .np-admin .np-grid, .np-admin .np-map, .np-admin .np-stats, .np-admin .np-look { display:block; }
  .np-admin .np-nav { width:auto; position:static; margin-bottom:12px; }
  .np-admin .np-stats div { margin-bottom:8px; }
}
</style>
<script>
(function () {
  var token = '{{ user_token }}';
  var log = document.getElementById('sync-log');

  document.querySelectorAll('.np-nav button').forEach(function (button) {
    button.addEventListener('click', function () {
      document.querySelectorAll('.np-nav button, .np-pane').forEach(function (node) {
        node.classList.remove('is-on');
      });
      button.classList.add('is-on');
      document.getElementById('np-' + button.getAttribute('data-pane')).classList.add('is-on');
    });
  });

  function write(line) {
    log.textContent += line + "\n";
    log.scrollTop = log.scrollHeight;
  }

  $('#button-save-key, #button-api-check').on('click', function () {
    var check = this.id === 'button-api-check';
    $('#api-check-result').text('...');
    var key = $('#input-api-key').val();
    $.post('index.php?route=extension/shipping/novaposhta/saveKey&user_token=' + token, { key: key }, function (saved) {
      if (!saved || saved.error) {
        $('#api-check-result').text(saved && saved.error ? saved.error : 'error');
        return;
      }
      if (!check) {
        $('#api-check-result').text(saved.success || 'OK');
        return;
      }
      $.post('index.php?route=extension/shipping/novaposhta/apiCheck&user_token=' + token, { key: key }, function (json) {
        if (json.error) {
          $('#api-check-result').text(json.error);
          return;
        }
        var select = $('#input-sender').empty();
        $.each(json.senders || [], function (_, row) {
          select.append($('<option>').val(row.ref).text(row.name).attr('data-real', '1'));
        });
        $('#api-check-result').text((saved.success || 'OK') + ' / ' + (json.senders || []).length);
        select.trigger('change');
      }, 'json');
    }, 'json');
  });

  function chosenName($select) {
    var $option = $select.find(':selected');
    if ($option.attr('data-real') !== '1') return '';
    var text = $.trim($option.text());
    if (/^[0-9a-f]{8}-[0-9a-f-]{27,}$/i.test(text)) return '';
    return text;
  }
  function rememberNames() {
    var sender = chosenName($('#input-sender'));
    var contact = chosenName($('#input-contact'));
    var address = chosenName($('#input-address'));
    if (sender) $('#input-sender-name').val(sender);
    if (contact) $('#input-contact-name').val(contact);
    if (address) $('#input-address-name').val(address);
  }
  $('#input-sender').on('change', function () {
    var ref = $(this).val();
    if (!ref) return;
    $.getJSON('index.php?route=extension/shipping/novaposhta/senderData&user_token=' + token + '&ref=' + encodeURIComponent(ref), function (json) {
      if (json.error) return;
      var contacts = $('#input-contact').empty();
      $.each(json.contacts || [], function (_, row) {
        contacts.append($('<option>').val(row.ref).text(row.name).attr('data-phone', row.phone || '').attr('data-real', '1'));
      });
      var addresses = $('#input-address').empty();
      $.each(json.addresses || [], function (_, row) {
        addresses.append($('<option>').val(row.ref).text(row.name).attr('data-city', row.city_ref || '').attr('data-real', '1'));
      });
      if (!addresses.children().length) {
        addresses.append($('<option>').val('').text(json.address_empty || ''));
      }
      contacts.trigger('change');
      addresses.trigger('change');
      rememberNames();
    });
  });

  $('#input-contact, #input-address').on('change', function () {
    rememberNames();
  });

  $('#input-contact').on('change', function () {
    var phone = $(this).find(':selected').attr('data-phone');
    if (phone) $('#input-phone').val(phone);
  });

  $('#input-address').on('change', function () {
    var city = $(this).find(':selected').attr('data-city');
    if (city) $('#input-sender-city').val(city);
  });

  $('#button-sync').on('click', function () {
    var button = $(this);
    button.prop('disabled', true);
    log.textContent = '';
    function paint(counts) {
      if (!counts) return;
      $('#np-stat-regions').text(counts.regions);
      $('#np-stat-cities').text(counts.cities);
      $('#np-stat-branches').text(counts.warehouses);
      $('#np-stat-lockers').text(counts.lockers);
    }
    function step(state) {
      $.ajax({
        url: 'index.php?route=extension/shipping/novaposhta/sync&user_token=' + token + '&job=' + encodeURIComponent(state.job) + '&page=' + state.page + '&type=' + encodeURIComponent(state.type || ''),
        type: 'POST',
        dataType: 'json',
        data: { key: $('#input-api-key').val() },
        success: function (json) {
          if (json.error) {
            write('ERROR: ' + json.error);
            button.prop('disabled', false);
            return;
          }
          write((json.label || state.job) + '  +' + (json.received || 0));
          paint(json.counts);
          if (json.next) {
            step(json.next);
            return;
          }
          write('done');
          button.text(button.data('label-update') || button.text());
          button.prop('disabled', false);
        },
        error: function (xhr) {
          var text = (xhr.responseText || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').slice(0, 280);
          write(text || 'request failed');
          button.prop('disabled', false);
        }
      });
    }
    step({ job: 'areas', page: 1, type: '' });
  });

  var tariffRow = {{ shipping_novaposhta_tariff|length }};
  $('#button-tariff-add').on('click', function () {
    var i = tariffRow++;
    var cells = ['weight', 'warehouse', 'city', 'region', 'ukraine', 'doors', 'doors_pickup', 'locker'].map(function (name) {
      return '<td><input name="shipping_novaposhta_tariff[' + i + '][' + name + ']" value="" /></td>';
    }).join('');
    $('#tariff-table tbody').append('<tr>' + cells + '<td><button type="button" class="np-icon" onclick="$(this).closest(\'tr\').remove();"><i class="fa fa-times"></i></button></td></tr>');
  });

  $('.np-probe').on('click', function () {
    var index = $(this).data('index');
    var card = $(this).closest('.np-card');
    var key = card.find('[name="shipping_novaposhta_senders[' + index + '][api_key]"]').val() || $('#input-api-key').val();
    $.post('index.php?route=extension/shipping/novaposhta/apiCheck&user_token=' + token, { key: key, probe: 1 }, function (json) {
      if (!json || json.error) {
        window.alert(json && json.error ? json.error : 'error');
        return;
      }
      var select = $('<select class="np-sender-pick"></select>');
      $.each(json.senders || [], function (_, row) {
        select.append($('<option>').val(row.ref).text(row.name));
      });
      card.find('.np-sender-pick').remove();
      card.append(select);
      select.on('change', function () {
        card.find('[name="shipping_novaposhta_senders[' + index + '][ref]"]').val(this.value);
        $.getJSON('index.php?route=extension/shipping/novaposhta/senderData&user_token=' + token + '&ref=' + encodeURIComponent(this.value) + '&key=' + encodeURIComponent(key), function (data) {
          if (data.contacts && data.contacts[0]) {
            card.find('[name="shipping_novaposhta_senders[' + index + '][contact]"]').val(data.contacts[0].ref);
            card.find('[name="shipping_novaposhta_senders[' + index + '][contact_name]"]').val(data.contacts[0].name);
            card.find('[name="shipping_novaposhta_senders[' + index + '][phone]"]').val(data.contacts[0].phone);
          }
          if (data.addresses && data.addresses[0]) {
            card.find('[name="shipping_novaposhta_senders[' + index + '][address]"]').val(data.addresses[0].ref);
            card.find('[name="shipping_novaposhta_senders[' + index + '][city]"]').val(data.addresses[0].city_ref);
          }
        });
      });
      select.trigger('change');
    }, 'json');
  });

  var help = {};
  try { help = JSON.parse($('#np-help-data').text() || '{}'); } catch (e) { help = {}; }
  $('.np-help').on('click', function () {
    var pane = help[$(this).data('help')] || {};
    $('#np-help-title').text(pane.title || '');
    $('#np-help-text').text(pane.text || '');
    $('#np-help').removeAttr('hidden');
  });
  $('.np-help-x, #np-help').on('click', function (e) {
    if (e.target === this) $('#np-help').attr('hidden', 'hidden');
  });
})();
</script>
{{ footer }}
