{{ header }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="view/javascript/novaposhta/module.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter','system-ui','sans-serif'], mono: ['JetBrains Mono','ui-monospace','monospace'] } } } };
</script>
<style>
#header, #column-left, #footer { display: none !important; }
#content { margin: 0 !important; padding: 0 !important; min-height: 100vh !important; }
body { background: #f3f4f6; }
</style>
<div id="np-app" class="font-sans text-[14px] leading-[1.45] antialiased min-h-screen bg-[#f3f4f6] text-[#111111]">
<!-- Всплывающие уведомления -->
<div id="toast-box" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

<!-- ======================================================================= -->
<!-- ПОЛНОШИРИННАЯ 3-КОЛОНОЧНАЯ СЕТКА (100vw)                                 -->
<!-- ======================================================================= -->
<div class="w-full min-h-screen flex flex-col lg:flex-row">

  <!-- ===================================================================== -->
  <!-- КОЛОНКА 1: ЛЕВАЯ НАВИГАЦИЯ (260px STICKY)                             -->
  <!-- ===================================================================== -->
  <aside class="w-full lg:w-[260px] shrink-0 bg-white border-b lg:border-b-0 lg:border-r border-[#e4e5e9] lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto p-4 flex flex-col justify-between gap-4">
    <div class="space-y-4">
      <!-- Бренд -->
      <div class="flex items-center justify-between gap-2 px-1">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-[8px] bg-[#111111] text-white font-extrabold text-sm tracking-tighter flex items-center justify-center relative">
            НП
            <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#c42323] border-2 border-white"></span>
          </div>
          <div>
            <div class="font-extrabold text-[15px] tracking-tight text-[#111111] leading-tight">Новая Почта</div>
            <div class="text-[11px] font-mono text-[#5c6370]">API v2.0 • 66 методов</div>
          </div>
        </div>
      </div>

      <!-- Индикатор готовности модуля -->
      <div id="readiness-card" class="p-3 rounded-[10px] border border-[#e4e5e9] bg-[#f6f6f7] space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="font-bold text-[#111111]">Готовность к работе</span>
          <span id="readiness-badge" class="font-mono text-[11px] font-bold px-2 py-0.5 rounded-full bg-[#fdecec] text-[#c42323]">Нужен ключ</span>
        </div>
        <div class="w-full h-1.5 bg-[#e4e5e9] rounded-full overflow-hidden">
          <div id="readiness-bar" class="h-full bg-[#157a3a] rounded-full transition-all duration-300" style="width: 75%"></div>
        </div>
        <div id="readiness-hint" class="text-[11px] text-[#5c6370] leading-snug">
          Заполните обязательные поля без красных точек
        </div>
      </div>

      <!-- 6 логических шагов навигации -->
      <nav id="main-nav" class="flex lg:flex-col gap-1 overflow-x-auto pb-1 lg:pb-0" aria-label="Разделы настроек"></nav>

      <!-- Быстрое переключение пресетов в сайдбаре -->
      <div class="hidden lg:block pt-3 border-t border-[#e4e5e9] space-y-2">
        <div class="px-1 text-[10px] font-mono font-bold uppercase tracking-wider text-[#5c6370]">Быстрый пресет</div>
        <div class="space-y-1.5">
          <button type="button" data-preset="classic" class="preset-side-btn w-full text-left px-2.5 py-2 rounded-[8px] border border-[#e4e5e9] hover:border-[#111111] bg-white text-xs transition-colors">
            <div class="font-bold text-[#111111]">Классический E-commerce</div>
            <div class="text-[11px] text-[#5c6370]">Отделение + постомат + наложка</div>
          </button>
          <button type="button" data-preset="prepaid_free" class="preset-side-btn w-full text-left px-2.5 py-2 rounded-[8px] border border-[#e4e5e9] hover:border-[#111111] bg-white text-xs transition-colors">
            <div class="font-bold text-[#111111]">Предоплата + Бесплатно</div>
            <div class="text-[11px] text-[#5c6370]">Без наложки, от 2000 ₴ за наш счёт</div>
          </button>
          <button type="button" data-preset="b2b_control" class="preset-side-btn w-full text-left px-2.5 py-2 rounded-[8px] border border-[#e4e5e9] hover:border-[#111111] bg-white text-xs transition-colors">
            <div class="font-bold text-[#111111]">B2B / Контроль оплаты</div>
            <div class="text-[11px] text-[#5c6370]">Afterpayment на р/с ФЛП/ООО</div>
          </button>
        </div>
      </div>
    </div>

    <!-- Статус API шлюза -->
    <div class="hidden lg:flex items-center justify-between px-3 py-2 rounded-[8px] border border-[#b7e4c7] bg-[#e8f6ee] text-[11px]">
      <span class="flex items-center gap-1.5 font-bold text-[#157a3a]">
        <span class="w-2 h-2 rounded-full bg-[#157a3a]"></span>
        api.novaposhta.ua/v2.0
      </span>
      <span class="font-mono font-bold text-[#157a3a]">JSON</span>
    </div>
  </aside>

  <!-- ===================================================================== -->
  <!-- КОЛОНКА 2: ЦЕНТРАЛЬНАЯ РАБОЧАЯ ОБЛАСТЬ (FLEX-1)                       -->
  <!-- ===================================================================== -->
  <main class="flex-1 min-w-0 flex flex-col justify-between pb-20">
    <div class="p-4 sm:p-6 space-y-5">

      <!-- Верхняя панель пресетов и живых блокеров -->
      <div class="bg-white border border-[#e4e5e9] rounded-[12px] p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#5c6370]">Сценарии быстрого старта (1 клик)</span>
            <h2 class="text-sm font-extrabold text-[#111111]">Настройте связку доставки и оплаты под модель магазина</h2>
          </div>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" data-preset="classic" class="preset-top-btn px-3 py-1.5 rounded-[8px] border border-[#111111] bg-[#111111] text-white text-xs font-bold transition-colors">
              Классический E-commerce
            </button>
            <button type="button" data-preset="prepaid_free" class="preset-top-btn px-3 py-1.5 rounded-[8px] border border-[#e4e5e9] hover:border-[#111111] bg-white text-[#111111] text-xs font-bold transition-colors">
              Предоплата + Бесплатно от 2000 ₴
            </button>
            <button type="button" data-preset="b2b_control" class="preset-top-btn px-3 py-1.5 rounded-[8px] border border-[#e4e5e9] hover:border-[#111111] bg-white text-[#111111] text-xs font-bold transition-colors">
              B2B / Контроль оплаты
            </button>
          </div>
        </div>

        <!-- Кликабельная полоса блокеров / валидации -->
        <div id="issues-banner" class="space-y-1.5"></div>
      </div>

      <!-- Динамический контент активного шага -->
      <div id="workspace-view" class="space-y-4"></div>

    </div>

    <!-- Фиксированная нижняя панель управления конфигурацией -->
    <footer class="sticky bottom-0 z-30 bg-white/95 backdrop-blur border-t border-[#e4e5e9] px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2 text-xs text-[#5c6370]">
        <span class="w-2 h-2 rounded-full bg-[#157a3a]"></span>
        <span>Автосохранение в браузере активно</span>
      </div>
      <div class="flex items-center gap-2">
        <a data-np-nav="/dispatch" href="/dispatch" class="px-3.5 py-2 rounded-[8px] border border-[#e4e5e9] hover:border-[#111111] bg-white text-xs font-bold text-[#111111] transition-colors">Диспетчер ЭН</a>
        <button type="button" id="btn-reset" class="px-3.5 py-2 rounded-[8px] border border-[#e4e5e9] hover:border-[#c42323] hover:text-[#c42323] bg-white text-xs font-bold text-[#111111] transition-colors">
          Сбросить
        </button>
        <label class="px-3.5 py-2 rounded-[8px] border border-[#e4e5e9] hover:border-[#111111] bg-white text-xs font-bold text-[#111111] transition-colors cursor-pointer">
          Импорт JSON
          <input type="file" id="input-import-json" accept="application/json" class="hidden">
        </label>
        <button type="button" id="btn-download-json" class="px-4 py-2 rounded-[8px] bg-[#111111] hover:bg-[#27272a] text-white text-xs font-bold transition-colors">
          Скачать JSON
        </button>
      </div>
    </footer>
  </main>

  <!-- ===================================================================== -->
  <!-- КОЛОНКА 3: ПРАВЫЙ ЖИВОЙ ИНСПЕКТОР (370px STICKY)                      -->
  <!-- ===================================================================== -->
  <aside class="w-full lg:w-[370px] shrink-0 bg-white border-t lg:border-t-0 lg:border-l border-[#e4e5e9] lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto p-4 flex flex-col gap-3.5">

    <!-- Переключатель вкладок инспектора -->
    <div class="grid grid-cols-2 p-1 rounded-[10px] bg-[#f3f4f6] border border-[#e4e5e9]">
      <button type="button" id="tab-preview-btn" class="py-1.5 px-3 rounded-[8px] bg-[#111111] text-white text-xs font-bold transition-colors">
        Вид на чекауте
      </button>
      <button type="button" id="tab-json-btn" class="py-1.5 px-3 rounded-[8px] text-[#5c6370] hover:text-[#111111] text-xs font-bold transition-colors">
        JSON save
      </button>
    </div>

    <!-- ВКЛАДКА 1: ОРИЕНТИРОВОЧНЫЙ ВИД НА ЧЕКАУТЕ -->
    <div id="inspector-preview-pane" class="space-y-3.5">
      <!-- Обязательный дисклеймер -->
      <div class="p-3 rounded-[10px] border border-[#111111] bg-[#f6f6f7] flex items-start gap-2.5">
        <span class="w-2 h-2 rounded-full bg-[#c42323] mt-1.5 shrink-0"></span>
        <p class="text-[11px] text-[#5c6370] leading-snug">
          <strong class="text-[#111111] font-bold">Ориентировочный вид:</strong> итоговое отображение зависит от модуля заказа и темы оформления магазина.
        </p>
      </div>

      <!-- Симулятор корзины (сумма 300–5000 ₴ и вес посылки) -->
      <div class="p-3.5 rounded-[10px] border border-[#e4e5e9] bg-white space-y-3">
        <div class="space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-[#5c6370]">Сумма товаров в корзине:</span>
            <span id="sim-cart-label" class="font-mono font-extrabold text-sm text-[#111111] bg-[#f6f6f7] px-2 py-0.5 rounded-[6px] border border-[#e4e5e9]">1 850 ₴</span>
          </div>
          <input type="range" id="sim-cart-range" min="300" max="5000" step="50" value="1850" class="w-full">
          <div class="flex justify-between font-mono text-[10px] text-[#5c6370]">
            <span>300 ₴</span>
            <span>5 000 ₴</span>
          </div>
        </div>

        <div class="pt-2.5 border-t border-[#e4e5e9] space-y-1.5">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-[#5c6370]">Тестовый вес посылки:</span>
            <span id="sim-weight-label" class="font-mono font-extrabold text-xs text-[#111111]">1.5 кг</span>
          </div>
          <input type="range" id="sim-weight-range" min="0.5" max="45" step="0.5" value="1.5" class="w-full">
          <div class="flex justify-between font-mono text-[10px] text-[#5c6370]">
            <span>0.5 кг</span>
            <span>20 кг (почтомат)</span>
            <span>45 кг</span>
          </div>
        </div>
      </div>

      <!-- Блок доставки глазами покупателя -->
      <div class="p-3.5 rounded-[10px] border border-[#e4e5e9] bg-white space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-extrabold text-[#111111]">Доставка Новой Почтой</span>
          <span id="sim-module-status" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-[#e8f6ee] text-[#157a3a]">Активен</span>
        </div>

        <select id="sim-city" class="w-full px-2.5 py-1.5 rounded-[8px] border border-[#d5d7dd] bg-white text-xs font-semibold text-[#111111]">
          <option>м. Львів (Львівська обл.)</option>
          <option>м. Київ (Київська обл.)</option>
          <option>м. Одеса (Одеська обл.)</option>
        </select>

        <!-- Список активных ServiceTypes -->
        <div id="sim-services-container" class="space-y-1.5"></div>

        <!-- Предупреждение по габаритам/весу почтомата -->
        <div id="sim-postomat-alert" class="hidden p-2.5 rounded-[8px] bg-[#fdecec] border border-[#f3c7c7] text-[11px] text-[#c42323] font-medium leading-snug"></div>

        <!-- Выбор отделения/адреса -->
        <div id="sim-point-box" class="space-y-1">
          <div id="sim-point-label" class="text-[10px] font-mono uppercase text-[#5c6370]">Точка выдачи</div>
          <select id="sim-point-select" class="w-full px-2.5 py-1.5 rounded-[8px] border border-[#d5d7dd] bg-[#f6f6f7] text-[11px] font-semibold text-[#111111]"></select>
        </div>

        <!-- Прогресс-бар бесплатной доставки -->
        <div id="sim-free-box" class="hidden p-2.5 rounded-[8px] bg-[#e8f6ee] border border-[#b7e4c7] space-y-1">
          <div class="flex justify-between text-[11px] font-bold text-[#157a3a]">
            <span id="sim-free-msg">До бесплатной доставки: 150 ₴</span>
            <span id="sim-free-pct" class="font-mono">92%</span>
          </div>
          <div class="w-full h-1.5 bg-white rounded-full overflow-hidden">
            <div id="sim-free-bar" class="h-full bg-[#157a3a] rounded-full transition-all duration-300" style="width: 92%"></div>
          </div>
        </div>
      </div>

      <!-- Калькулятор выплаты и комиссии наложки -->
      <div class="p-3.5 rounded-[10px] border border-[#111111] bg-[#f6f6f7] space-y-2">
        <div class="flex items-center justify-between border-b border-[#e4e5e9] pb-1.5">
          <span class="text-xs font-extrabold text-[#111111]">Расчет оплаты и комиссии</span>
          <span id="sim-payout-badge" class="font-mono text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#e8f6ee] text-[#157a3a]">Маржа ОК</span>
        </div>
        <div class="space-y-1 text-xs">
          <div class="flex justify-between">
            <span class="text-[#5c6370]">Сумма заказа:</span>
            <span id="calc-order-total" class="font-mono font-bold text-[#111111]">1 850 ₴</span>
          </div>
          <div class="flex justify-between">
            <span id="calc-ship-who" class="text-[#5c6370]">Доставка (платит клиент):</span>
            <span id="calc-ship-val" class="font-mono font-semibold text-[#111111]">70 ₴</span>
          </div>
          <div id="calc-cod-line" class="flex justify-between">
            <span id="calc-cod-who" class="text-[#5c6370]">Комиссия наложки (клиент):</span>
            <span id="calc-cod-val" class="font-mono font-bold text-[#c42323]">57 ₴</span>
          </div>
          <div class="pt-1.5 border-t border-[#e4e5e9] flex justify-between items-center">
            <span class="font-extrabold text-[#111111]">Чистая выплата магазину:</span>
            <span id="calc-net-payout" class="font-mono text-sm font-extrabold text-[#157a3a]">1 850 ₴</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ВКЛАДКА 2: LIVE JSON PAYLOAD ДЛЯ SAVE -->
    <div id="inspector-json-pane" class="hidden flex-1 flex flex-col gap-2.5">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-xs font-extrabold text-[#111111]">Тело запроса API v2.0</div>
          <div id="json-model-subtitle" class="font-mono text-[11px] text-[#5c6370]">InternetDocument.save</div>
        </div>
        <button type="button" id="btn-copy-json" class="px-3 py-1.5 rounded-[8px] bg-[#111111] hover:bg-[#27272a] text-white text-xs font-bold transition-colors">
          Скопировать JSON
        </button>
      </div>
      <div class="p-2.5 rounded-[8px] bg-[#f6f6f7] border border-[#e4e5e9] text-[11px] text-[#5c6370]">
        Обновляется в реальном времени при любом изменении настроек. В фигурных скобках — переменные заказа.
      </div>
      <pre id="live-json-output" class="flex-1 m-0 p-3.5 rounded-[10px] bg-[#111111] text-[#f5f5f5] font-mono text-[11px] leading-[1.55] overflow-auto whitespace-pre"></pre>
    </div>

  </aside>
</div>

<!-- ======================================================================= -->
<!-- ПОЛНАЯ БАЗА 66 МЕТОДОВ API НОВОЙ ПОЧТЫ v2.0 (ИЗ РЕФЕРЕНСА)              -->
<!-- ======================================================================= -->
<script id="np-data" type="application/json">{"methods":[{"model":"Address","method":"searchSettlements","title":"Поиск населённого пункта","hint":"Живой поиск на чекауте. Не выгружайте всю Украину в браузер покупателя.","auth":"public","section":"step1"},{"model":"Address","method":"searchSettlementStreets","title":"Поиск улицы","hint":"Для адресной доставки. Нужен SettlementRef из searchSettlements.","auth":"public","section":"step1"},{"model":"Address","method":"getAreas","title":"Области","hint":"Короткий справочник. Обновляйте вместе с городами.","auth":"public","section":"step1"},{"model":"Address","method":"getCities","title":"Города","hint":"Классический справочник городов. Для тарифа и старых форм. Город отправителя берётся отсюда или из searchSettlements.","auth":"public","section":"step1"},{"model":"Address","method":"getSettlements","title":"Населённые пункты","hint":"Полный справочник. Тяжёлый: лучше ночной cron, на чекауте — searchSettlements.","auth":"public","section":"step1"},{"model":"Address","method":"getWarehouses","title":"Отделения и почтоматы","hint":"Список точек города. Фильтр по типу, весу и габаритам делайте у себя, API отдаёт ограничения точки.","auth":"public","section":"step1"},{"model":"Address","method":"getWarehouseTypes","title":"Типы отделений","hint":"Ref типов, чтобы отличить отделение, почтомат, грузовое и пункт приёма.","auth":"public","section":"step1"},{"model":"Address","method":"getStreet","title":"Улицы города","hint":"Пакетная выгрузка улиц. На чекауте удобнее searchSettlementStreets.","auth":"public","section":"step1"},{"model":"Address","method":"save","title":"Создать адрес контрагента","hint":"Адрес забора или доставки, привязанный к контрагенту. Нужен ключ.","auth":"key","section":"step1"},{"model":"Address","method":"update","title":"Обновить адрес","hint":"Правка дома, квартиры, примечания. Ref адреса не меняется.","auth":"key","section":"step1"},{"model":"Address","method":"delete","title":"Удалить адрес","hint":"Не удаляйте адрес, на который ещё ссылаются открытые накладные.","auth":"key","section":"step1"},{"model":"Common","method":"getCargoTypes","title":"Типы груза","hint":"Parcel, Cargo, Documents, TiresWheels, Pallet. Кладётся в CargoType.","auth":"public","section":"step4"},{"model":"Common","method":"getServiceTypes","title":"Технологии доставки","hint":"WarehouseWarehouse, WarehouseDoors, DoorsWarehouse, DoorsDoors.","auth":"public","section":"step2"},{"model":"Common","method":"getTypesOfPayers","title":"Кто платит за доставку","hint":"Sender, Recipient, ThirdPerson → поле PayerType.","auth":"public","section":"step3"},{"model":"Common","method":"getTypesOfPayersForRedelivery","title":"Кто платит за обратную доставку","hint":"Отдельный плательщик для BackwardDeliveryData, не путать с PayerType самой доставки.","auth":"public","section":"step3"},{"model":"Common","method":"getPaymentForms","title":"Форма оплаты доставки","hint":"Cash — нал / при получении. NonCash — безнал по договору. Поле PaymentMethod.","auth":"public","section":"step3"},{"model":"Common","method":"getBackwardDeliveryCargoTypes","title":"Что везти обратно","hint":"Деньги, документы, тара и прочее. Для наложки нужен CargoType Money.","auth":"public","section":"step3"},{"model":"Common","method":"getPackList","title":"Упаковка","hint":"Коробки и пакеты Новой Почты. Ref уходит в OptionsSeat.packRef и PackingNumber.","auth":"public","section":"step4"},{"model":"Common","method":"getPalletsList","title":"Виды палет","hint":"Только если CargoType = Pallet.","auth":"public","section":"step4"},{"model":"Common","method":"getTiresWheelsList","title":"Шины и диски","hint":"Справочник размеров. Не подставляйте описание товара вместо Ref.","auth":"public","section":"step4"},{"model":"Common","method":"getCargoDescriptionList","title":"Описание груза","hint":"Готовые формулировки. Для магазина чаще свой шаблон Description.","auth":"public","section":"step4"},{"model":"Common","method":"getTimeIntervals","ti