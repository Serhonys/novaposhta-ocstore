{{ header }}
<div id="account-novaposhta" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ text_my_parcels }}</h1>
      {% if rows %}
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>{{ column_order }}</th>
              <th>{{ column_city }}</th>
              <th>{{ column_ttn }}</th>
              <th>{{ column_status }}</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
            <tr>
              <td>#{{ row.order_id }}<div class="text-muted">{{ row.date }}</div></td>
              <td>{{ row.city }}<div class="text-muted">{{ row.point }}</div></td>
              <td>{% if row.track %}<a href="{{ row.track }}" target="_blank" rel="noopener">{{ row.cn }}</a>{% else %}{{ text_no_cn }}{% endif %}</td>
              <td>{{ row.status }}</td>
            </tr>
            {% if row.open %}
            <tr>
              <td colspan="4">
                <div class="np-change" data-order="{{ row.order_id }}">
                  <input type="text" class="form-control np-change-city" placeholder="{{ column_city }}" autocomplete="off" />
                  <input type="text" class="form-control np-change-point" placeholder="{{ column_ttn }}" autocomplete="off" />
                  <button type="button" class="btn btn-primary btn-sm">{{ button_save }}</button>
                </div>
              </td>
            </tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <p>{{ text_cn_empty }}</p>
      {% endif %}
      <a href="{{ back }}" class="btn btn-default">{{ button_back }}</a>
      <script>
      (function ($) {
        var cityUrl = '{{ city_url }}';
        var pointUrl = '{{ point_url }}';
        var changeUrl = '{{ change_url }}';
        function suggest($input, rows, onPick) {
          $input.siblings('.np-suggest').remove();
          if (!rows || !rows.length) return;
          var $list = $('<div class="np-suggest"></div>');
          $.each(rows, function (_, row) {
            var label = row.area ? (row.name + ', ' + row.area) : row.name;
            var $item = $('<button type="button"></button>').text(label);
            $item.on('mousedown', function (e) {
              e.preventDefault();
              onPick(row);
              $list.remove();
            });
            $list.append($item);
          });
          $input.after($list);
        }
        $('.np-change').each(function () {
          var $box = $(this);
          var cityRef = '';
          var pointRef = '';
          $box.find('.np-change-city').on('input', function () {
            var q = $.trim(this.value);
            cityRef = '';
            if (q.length < 2) return;
            $.getJSON(cityUrl, { q: q }, function (rows) {
              suggest($box.find('.np-change-city'), rows, function (row) {
                $box.find('.np-change-city').val(row.name);
                cityRef = row.ref;
              });
            });
          });
          $box.find('.np-change-point').on('input', function () {
            if (!cityRef) return;
            $.getJSON(pointUrl, { city_ref: cityRef, q: this.value }, function (rows) {
              suggest($box.find('.np-change-point'), rows, function (row) {
                $box.find('.np-change-point').val(row.name);
                pointRef = row.ref;
              });
            });
          });
          $box.find('button.btn').on('click', function () {
            $.post(changeUrl, {
              order_id: $box.data('order'),
              city_ref: cityRef,
              city_name: $box.find('.np-change-city').val(),
              division_ref: pointRef,
              division_name: $box.find('.np-change-point').val(),
              method: 'department'
            }, function (json) {
              if (json && json.error) {
                window.alert(json.error);
                return;
              }
              window.location.reload();
            }, 'json');
          });
        });
      })(window.jQuery);
      </script>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
